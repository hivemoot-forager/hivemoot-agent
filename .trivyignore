# minimatch ReDoS — bundled inside npm 11.10.1+ (transitive dep we cannot control).
# Remove once npm ships a release with minimatch >= 10.2.3.
# exp:2026-04-30
CVE-2026-27903
CVE-2026-27904

# tar Hardlink Path Traversal — transitive dep of a provider CLI (tar < 7.5.10).
# Drive-relative linkpath attack is Windows-specific; not exploitable in Linux containers.
# Track in #295. Remove once upstream provider releases a version pinning tar >= 7.5.10.
# exp:2026-05-30
CVE-2026-29786

# tar Symlink Path Traversal via Drive-Relative Linkpath — transitive dep bundled in npm / provider CLIs (tar < 7.5.11).
# Drive-relative linkpath attack is Windows-specific; not exploitable in Linux containers.
# Remove once npm and upstream providers ship with tar >= 7.5.11.
# exp:2026-07-31
CVE-2026-31802

# docker/cli Uncontrolled Search Path in plugin loading — embedded in the gh CLI Go binary.
# Requires a malicious plugin in PATH; not applicable in our container runtime context.
# Remove once gh ships a release embedding docker/cli >= 29.2.0.
# exp:2026-05-30
CVE-2025-15558

# Go stdlib url.Parse host/authority validation — embedded in the gh CLI Go binary (go < 1.25.8).
# Exploitable only if gh processes attacker-controlled URLs in ways that bypass validation;
# not applicable in our container runtime context.
# Remove once gh ships a release built with go >= 1.25.8 / 1.26.1.
# exp:2026-07-31
CVE-2026-25679

# Go stdlib HTML meta tag URL injection — embedded in the gh CLI Go binary (go < 1.25.8).
# Requires rendering HTML with attacker-controlled URLs; not applicable in container runtime.
# Remove once gh ships a release built with go >= 1.25.8 / 1.26.1.
